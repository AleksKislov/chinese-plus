{
  "manifest_version": 3,
  "name": "ChinesePlus: читай по-китайски с подсказками",
  "short_name": "ChinesePlus",
  "description": "Наведите курсор (или нажмите) на китайское слово, чтобы увидеть пиньинь и перевод. Работает офлайн.",
  "version": "1.3.0",
  "homepage_url": "https://www.chineseplus.club",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "ChinesePlus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+Y", "mac": "Alt+Shift+Y" },
      "description": "Включить / выключить словарь"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://chineseplus.club/*", "*://*.chineseplus.club/*"],
      "js": ["lib.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dictionary@chineseplus.club",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
