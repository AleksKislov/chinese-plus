meta {
  name: create simple
  type: http
  seq: 10
}

post {
  url: {{local_server}}/api/blogs/create
  body: json
  auth: none
}

headers {
  x-auth-token: {{authToken}}
}

body:json {
  {
    "postType": "simple",
    "content": [
      { "type": "carousel", "images": [
        { "url": "https://storage.yandexcloud.net/buyilehu/blog/some-user/uuid1.webp" },
        { "url": "https://storage.yandexcloud.net/buyilehu/blog/some-user/uuid2.webp" }
      ] },
      { "type": "text", "text": "Quick update, just like that!" }
    ]
  }
}
