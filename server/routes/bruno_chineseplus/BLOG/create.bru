meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{local_server}}/api/blogs/create
  body: json
  auth: none
}

headers {
  x-auth-token: {{authToken}}
}

body:json {
  {
    "postType": "article",
    "title": "My first blog post",
    "tags": ["hsk", "grammar"],
    "category": "general",
    "content": [
      { "type": "text", "text": "Some intro text" },
      { "type": "image", "url": "https://storage.yandexcloud.net/buyilehu/blog/some-user/uuid.webp", "caption": "" },
      { "type": "text", "text": "More text after the picture" }
    ]
  }
}
