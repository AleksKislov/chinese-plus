            }
          ]
        }
      ]
    },
    {
      "topic": "频率/重复副词: 常 / 常常 / 再",
      "content": [
        {
          "desc": "常/常常 — «часто», 再 — «снова/ещё раз».",
          "examples": [
            {
              "cn": [
                "他",
                "常",
                "去",
                "饭店",
                "吃饭",
                "。"
              ],
              "py": "tā cháng qù fàndiàn chīfàn",
              "ru": "Он часто ходит есть в ресторан."
            }
          ]
        }
      ]
    },
    {
      "topic": "关联副词: 还 / 也",
      "content": [
        {
          "desc": "还 — «ещё/к тому же», 也 — «тоже».",
          "examples": [
