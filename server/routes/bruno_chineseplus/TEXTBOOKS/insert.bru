meta {
  name: insert
  type: http
  seq: 2
}

post {
  url: {{local_server}}/api/textbooks/new
  body: json
  auth: inherit
}

params:query {
  ~lvl: 1
}

body:json {
  {
    "level": "1",
    "all": [
    {
      "topic": "方位名词 (пространственные существительные): 上 / 下 / 里 / 外 / 前 / 后 …",
      "content": [
        {
          "desc": "Слова места/направления: где находится предмет (на/под/внутри/снаружи/перед/за и т. п.).",
          "examples": [
            {
              "cn": [
                "手机",
                "在",
                "书包",
                "里",
                "。"
              ],
              "py": "shǒujī zài shūbāo lǐ",
              "ru": "Телефон в рюкзаке."
            }
          ]
        }
      ]
    },
    {
      "topic": "能愿动词 (модальные): 会 / 能",
      "content": [
        {
          "desc": "会 — «уметь/владеть навыком», 能 — «мочь (по обстоятельствам/физически)».",
          "examples": [
            {
              "cn": [
                "我",
                "不",
                "会",
                "说",
                "中文",
                "。"
              ],
              "py": "wǒ bú huì shuō zhōngwén",
              "ru": "Я не умею говорить по-китайски."
            },
            {
              "cn": [
                "明天",
                "你",
                "能",
                "来",
                "吗",
                "？"
              ],
              "py": "míngtiān nǐ néng lái ma",
              "ru": "Ты сможешь прийти завтра?"
            }
          ]
        }
      ]
    },
    {
      "topic": "能愿动词 (модальные): 想 / 要",
      "content": [
        {
          "desc": "想 — «хотеть/хотел бы», 要 — «хотеть/нужно/собираюсь».",
          "examples": [
            {
              "cn": [
                "我",
                "想",
                "学",
                "中文",
                "。"
              ],
              "py": "wǒ xiǎng xué zhōngwén",
              "ru": "Я хочу учить китайский."
            }
          ]
        }
      ]
    },
    {
      "topic": "疑问代词 (вопросительные местоимения): 多 / 多少 / 几 / 哪 / 哪儿 / 哪里 / 哪些 / 什么 / 谁 / 怎么",
      "content": [
        {
          "desc": "Вопросительные слова: «сколько/какой/где/какие/что/кто/как».",
          "examples": [
            {
              "cn": [
                "你",
                "买",
                "什么",
                "？"
              ],
              "py": "nǐ mǎi shénme",
              "ru": "Что ты покупаешь?"
            }
          ]
        }
      ]
    },
    {
      "topic": "人称代词 (личные местоимения): 我 / 你 / 您 / 他 / 她 / 我们 / 你们 / 他们 / 她们",
      "content": [
        {
          "desc": "Личные местоимения: я, ты/вы, он/она, мы, вы, они.",
          "examples": [
            {
              "cn": [
                "他",
                "们",
                "是",
                "学生",
                "。"
              ],
              "py": "tāmen shì xuéshēng",
              "ru": "Они — студенты."
            }
          ]
        }
      ]
    },
    {
      "topic": "指示代词 (указательные): 这 / 那 / 这儿 / 那儿 / 这里 / 那里 / 这些 / 那些 / 别的 / 有的",
      "content": [
        {
          "desc": "Указание на «этот/тот», «здесь/там», «эти/те», «другие», «некоторые».",
          "examples": [
            {
              "cn": [
                "你",
                "坐",
                "这里",
                "，",
                "弟弟",
                "坐",
                "那里",
                "。"
              ],
              "py": "nǐ zuò zhèlǐ, dìdi zuò nàli",
              "ru": "Ты сиди здесь, младший брат — там."
