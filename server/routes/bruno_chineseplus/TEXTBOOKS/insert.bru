              "cn": [
                "他",
                "是",
                "学生",
                "，",
                "我",
                "也",
                "是",
                "学生",
                "。"
              ],
              "py": "tā shì xuéshēng, wǒ yě shì xuéshēng",
              "ru": "Он студент, и я тоже студент."
